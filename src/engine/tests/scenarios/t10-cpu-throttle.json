{
  "id": "t10-cpu-throttle",
  "name": "CPU throttling",
  "description": "Limit a participant to cpus cores through Docker during the pressure phase.",
  "reveals": "External resource pressure versus internal behaviour; which style degrades gracefully.",
  "tags": [
    "resources"
  ],
  "requires": {
    "kinds": [
      "infra",
      "service"
    ]
  },
  "params": {
    "rps": 40,
    "concurrency": 64,
    "cpus": 0.1,
    "duration_s": 60
  },
  "timeline": [
    {
      "at_s": 0,
      "do": "load.set",
      "args": {
        "rps": "{rps}",
        "concurrency": "{concurrency}"
      }
    },
    {
      "at_s": 10,
      "do": "phase",
      "phase": "steady"
    },
    {
      "at_s": 20,
      "do": "phase",
      "phase": "pressure"
    },
    {
      "at_s": 20,
      "do": "resources.set",
      "kind": "participant",
      "args": {
        "cpus": "{cpus}"
      }
    },
    {
      "at_s": 20,
      "do": "control",
      "kind": "participant",
      "args": {
        "op": "work.set",
        "params": {
          "cpu_ms": 15
        }
      }
    },
    {
      "at_s": 40,
      "do": "phase",
      "phase": "recovery"
    },
    {
      "at_s": 40,
      "do": "resources.set",
      "kind": "participant",
      "args": {}
    },
    {
      "at_s": 40,
      "do": "control",
      "kind": "participant",
      "args": {
        "op": "work.set",
        "params": {
          "cpu_ms": 2
        }
      }
    },
    {
      "at_s": "{duration_s}",
      "do": "load.stop"
    },
    {
      "at_s": "{duration_s}",
      "do": "end"
    }
  ],
  "collect": [
    "sagas_per_sec",
    "latency_p50_ms",
    "latency_p99_ms",
    "error_rate",
    "consumer_lag",
    "cpu_pct",
    "sagas_ok_total",
    "sagas_failed_total",
    "nodes_healthy",
    "link.error_rate[*]",
    "container.cpu[*]",
    "container.mem_mb[*]"
  ],
  "assert": [
    {
      "metric": "error_rate.mean",
      "op": "<=",
      "value": 0.01,
      "phase": "steady"
    }
  ]
}
