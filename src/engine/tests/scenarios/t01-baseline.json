{
  "id": "t01-baseline",
  "name": "Baseline",
  "description": "Constant load for the whole run; the reference numbers every other scenario is compared against.",
  "reveals": "The cost of the broker hop versus the orchestrator's sequential calls at equal load.",
  "tags": [
    "capacity"
  ],
  "requires": {
    "kinds": [
      "infra",
      "service"
    ]
  },
  "params": {
    "rps": 50,
    "concurrency": 64,
    "duration_s": 60
  },
  "timeline": [
    {
      "at_s": 0,
      "do": "load.set",
      "args": {
        "rps": "{rps}",
        "concurrency": "{concurrency}"
      }
    },
    {
      "at_s": 10,
      "do": "phase",
      "phase": "steady"
    },
    {
      "at_s": "{duration_s}",
      "do": "load.stop"
    },
    {
      "at_s": "{duration_s}",
      "do": "phase",
      "phase": "drain"
    },
    {
      "at_s": "{duration_s}",
      "do": "end"
    }
  ],
  "collect": [
    "sagas_per_sec",
    "latency_p50_ms",
    "latency_p99_ms",
    "error_rate",
    "consumer_lag",
    "cpu_pct",
    "sagas_ok_total",
    "sagas_failed_total",
    "nodes_healthy",
    "link.error_rate[*]",
    "container.cpu[*]",
    "container.mem_mb[*]"
  ],
  "assert": [
    {
      "metric": "error_rate.mean",
      "op": "<=",
      "value": 0.01,
      "phase": "steady",
      "note": "baseline error rate"
    },
    {
      "metric": "sagas_per_sec.mean",
      "op": ">=",
      "value": 40,
      "phase": "steady",
      "note": "throughput near the target"
    }
  ]
}
