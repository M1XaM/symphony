{
  "id": "t04-crash",
  "name": "Service crash mid-saga",
  "description": "Steady load; a participant service is killed for down_s and restarted.",
  "reveals": "Orchestration compensates and fails fast; choreography queues and replays. Same outage, different failure shapes.",
  "tags": [
    "resilience"
  ],
  "requires": {
    "kinds": [
      "infra",
      "service"
    ]
  },
  "params": {
    "rps": 40,
    "concurrency": 64,
    "down_s": 10,
    "duration_s": 60
  },
  "timeline": [
    {
      "at_s": 0,
      "do": "load.set",
      "args": {
        "rps": "{rps}",
        "concurrency": "{concurrency}"
      }
    },
    {
      "at_s": 10,
      "do": "phase",
      "phase": "steady"
    },
    {
      "at_s": 20,
      "do": "phase",
      "phase": "fault"
    },
    {
      "at_s": 20,
      "do": "restart",
      "kind": "participant",
      "args": {
        "after_s": "{down_s}"
      }
    },
    {
      "at_s": "30",
      "do": "phase",
      "phase": "recovery"
    },
    {
      "at_s": "{duration_s}",
      "do": "load.stop"
    },
    {
      "at_s": "{duration_s}",
      "do": "end"
    }
  ],
  "collect": [
    "sagas_per_sec",
    "latency_p50_ms",
    "latency_p99_ms",
    "error_rate",
    "consumer_lag",
    "cpu_pct",
    "sagas_ok_total",
    "sagas_failed_total",
    "nodes_healthy",
    "link.error_rate[*]",
    "container.cpu[*]",
    "container.mem_mb[*]"
  ],
  "assert": [
    {
      "metric": "error_rate.mean",
      "op": "<=",
      "value": 0.01,
      "phase": "steady"
    },
    {
      "metric": "recovery_time_s",
      "op": "<=",
      "value": 30,
      "note": "back under 2% errors within 30s of the restart"
    }
  ]
}
