{
  "id": "t18-cold-start",
  "name": "Cold start",
  "description": "Tear the template down, apply it again, and measure until traffic flows.",
  "reveals": "The cost of the broker/database warm-up and the order of readiness.",
  "tags": [
    "operations"
  ],
  "requires": {
    "kinds": [
      "infra",
      "service"
    ]
  },
  "params": {
    "rps": 20,
    "concurrency": 32,
    "duration_s": 45
  },
  "timeline": [
    {
      "at_s": 0,
      "do": "phase",
      "phase": "teardown"
    },
    {
      "at_s": 0,
      "do": "teardown"
    },
    {
      "at_s": 2,
      "do": "phase",
      "phase": "apply"
    },
    {
      "at_s": 2,
      "do": "apply"
    },
    {
      "at_s": 3,
      "do": "phase",
      "phase": "first-traffic"
    },
    {
      "at_s": 3,
      "do": "load.set",
      "args": {
        "rps": "{rps}",
        "concurrency": "{concurrency}"
      }
    },
    {
      "at_s": 15,
      "do": "phase",
      "phase": "steady"
    },
    {
      "at_s": "{duration_s}",
      "do": "load.stop"
    },
    {
      "at_s": "{duration_s}",
      "do": "end"
    }
  ],
  "collect": [
    "sagas_per_sec",
    "latency_p50_ms",
    "latency_p99_ms",
    "error_rate",
    "consumer_lag",
    "cpu_pct",
    "sagas_ok_total",
    "sagas_failed_total",
    "nodes_healthy",
    "link.error_rate[*]",
    "container.cpu[*]",
    "container.mem_mb[*]"
  ],
  "assert": [
    {
      "metric": "sagas_per_sec.mean",
      "op": ">=",
      "value": 10,
      "phase": "steady"
    }
  ]
}
