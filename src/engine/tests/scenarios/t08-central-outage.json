{
  "id": "t08-central-outage",
  "name": "Central component outage",
  "description": "Pause the component everything depends on (the broker, or the first service) for down_s.",
  "reveals": "The single point of failure of each style and how it recovers.",
  "tags": [
    "resilience"
  ],
  "requires": {
    "kinds": [
      "infra",
      "service"
    ]
  },
  "params": {
    "rps": 40,
    "concurrency": 64,
    "down_s": 10,
    "duration_s": 60
  },
  "timeline": [
    {
      "at_s": 0,
      "do": "load.set",
      "args": {
        "rps": "{rps}",
        "concurrency": "{concurrency}"
      }
    },
    {
      "at_s": 10,
      "do": "phase",
      "phase": "steady"
    },
    {
      "at_s": 20,
      "do": "phase",
      "phase": "outage"
    },
    {
      "at_s": 20,
      "do": "fault.set",
      "kind": "central",
      "args": {
        "kind": "pause",
        "duration_s": "{down_s}"
      }
    },
    {
      "at_s": 30,
      "do": "phase",
      "phase": "recovery"
    },
    {
      "at_s": "{duration_s}",
      "do": "load.stop"
    },
    {
      "at_s": "{duration_s}",
      "do": "end"
    }
  ],
  "collect": [
    "sagas_per_sec",
    "latency_p50_ms",
    "latency_p99_ms",
    "error_rate",
    "consumer_lag",
    "cpu_pct",
    "sagas_ok_total",
    "sagas_failed_total",
    "nodes_healthy",
    "link.error_rate[*]",
    "container.cpu[*]",
    "container.mem_mb[*]"
  ],
  "assert": [
    {
      "metric": "recovery_time_s",
      "op": "<=",
      "value": 30
    }
  ]
}
