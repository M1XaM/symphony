{
  "id": "t03-burst",
  "name": "Burst",
  "description": "Baseline rps with periodic bursts of factor x for burst_ms every period_ms.",
  "reveals": "How queues (broker) absorb spikes versus how synchronous chains reject them.",
  "tags": [
    "capacity"
  ],
  "requires": {
    "kinds": [
      "infra",
      "service"
    ]
  },
  "params": {
    "rps": 30,
    "factor": 5,
    "burst_ms": 2000,
    "period_ms": 10000,
    "concurrency": 128,
    "duration_s": 60
  },
  "timeline": [
    {
      "at_s": 0,
      "do": "load.set",
      "args": {
        "pattern": "burst",
        "rps": "{rps}",
        "factor": "{factor}",
        "burst_ms": "{burst_ms}",
        "period_ms": "{period_ms}",
        "concurrency": "{concurrency}"
      }
    },
    {
      "at_s": 5,
      "do": "phase",
      "phase": "steady"
    },
    {
      "at_s": "{duration_s}",
      "do": "load.stop"
    },
    {
      "at_s": "{duration_s}",
      "do": "end"
    }
  ],
  "collect": [
    "sagas_per_sec",
    "latency_p50_ms",
    "latency_p99_ms",
    "error_rate",
    "consumer_lag",
    "cpu_pct",
    "sagas_ok_total",
    "sagas_failed_total",
    "nodes_healthy",
    "link.error_rate[*]",
    "container.cpu[*]",
    "container.mem_mb[*]"
  ],
  "assert": [
    {
      "metric": "error_rate.mean",
      "op": "<=",
      "value": 0.05,
      "phase": "steady"
    }
  ]
}
