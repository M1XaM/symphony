{
  "id": "t13-retry-storm",
  "name": "Retry storm",
  "description": "Halve the entry service's timeout, raise its retries, then add latency on the proxied link.",
  "reveals": "Misconfigured resilience is worse than none: request amplification and what the circuit breaker prevents.",
  "tags": [
    "resilience"
  ],
  "requires": {
    "kinds": [
      "infra",
      "service"
    ],
    "needs_proxy": true
  },
  "params": {
    "rps": 30,
    "concurrency": 64,
    "timeout_ms": 150,
    "retry_max": 6,
    "ms": 200,
    "duration_s": 60
  },
  "timeline": [
    {
      "at_s": 0,
      "do": "load.set",
      "args": {
        "rps": "{rps}",
        "concurrency": "{concurrency}"
      }
    },
    {
      "at_s": 10,
      "do": "phase",
      "phase": "steady"
    },
    {
      "at_s": 15,
      "do": "config.set",
      "kind": "service",
      "args": {
        "timeout_ms": "{timeout_ms}",
        "retry_max": "{retry_max}"
      }
    },
    {
      "at_s": 20,
      "do": "phase",
      "phase": "fault"
    },
    {
      "at_s": 20,
      "do": "fault.set",
      "edge": "proxied",
      "args": {
        "kind": "latency",
        "ms": "{ms}",
        "duration_s": 20
      }
    },
    {
      "at_s": 40,
      "do": "phase",
      "phase": "recovery"
    },
    {
      "at_s": 40,
      "do": "config.set",
      "kind": "service",
      "args": {
        "timeout_ms": 800,
        "retry_max": 3
      }
    },
    {
      "at_s": "{duration_s}",
      "do": "load.stop"
    },
    {
      "at_s": "{duration_s}",
      "do": "end"
    }
  ],
  "collect": [
    "sagas_per_sec",
    "latency_p50_ms",
    "latency_p99_ms",
    "error_rate",
    "consumer_lag",
    "cpu_pct",
    "sagas_ok_total",
    "sagas_failed_total",
    "nodes_healthy",
    "link.error_rate[*]",
    "container.cpu[*]",
    "container.mem_mb[*]"
  ],
  "assert": [
    {
      "metric": "error_rate.mean",
      "op": "<=",
      "value": 0.01,
      "phase": "steady"
    }
  ]
}
