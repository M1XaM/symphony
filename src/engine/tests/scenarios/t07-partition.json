{
  "id": "t07-partition",
  "name": "Selective partition",
  "description": "Cut the proxied link entirely (100% drop) for the fault phase, then heal.",
  "reveals": "The broker keeps the system alive at the cost of lag and memory; the orchestrator fails sagas immediately.",
  "tags": [
    "network"
  ],
  "requires": {
    "kinds": [
      "infra",
      "service"
    ],
    "needs_proxy": true
  },
  "params": {
    "rps": 40,
    "concurrency": 64,
    "duration_s": 70
  },
  "timeline": [
    {
      "at_s": 0,
      "do": "load.set",
      "args": {
        "rps": "{rps}",
        "concurrency": "{concurrency}"
      }
    },
    {
      "at_s": 10,
      "do": "phase",
      "phase": "steady"
    },
    {
      "at_s": 20,
      "do": "phase",
      "phase": "fault"
    },
    {
      "at_s": 20,
      "do": "fault.set",
      "edge": "proxied",
      "args": {
        "kind": "drop",
        "rate": 1.0,
        "duration_s": 15
      }
    },
    {
      "at_s": 35,
      "do": "phase",
      "phase": "recovery"
    },
    {
      "at_s": "{duration_s}",
      "do": "load.stop"
    },
    {
      "at_s": "{duration_s}",
      "do": "end"
    }
  ],
  "collect": [
    "sagas_per_sec",
    "latency_p50_ms",
    "latency_p99_ms",
    "error_rate",
    "consumer_lag",
    "cpu_pct",
    "sagas_ok_total",
    "sagas_failed_total",
    "nodes_healthy",
    "link.error_rate[*]",
    "container.cpu[*]",
    "container.mem_mb[*]"
  ],
  "assert": [
    {
      "metric": "error_rate.mean",
      "op": "<=",
      "value": 0.01,
      "phase": "steady"
    },
    {
      "metric": "recovery_time_s",
      "op": "<=",
      "value": 30
    }
  ]
}
