{
  "id": "t05-link-latency",
  "name": "Link latency",
  "description": "+ms of latency on the proxied link for the fault phase.",
  "reveals": "Latency amplification through timeouts and retries; whether the retry budget makes things worse.",
  "tags": [
    "network"
  ],
  "requires": {
    "kinds": [
      "infra",
      "service"
    ],
    "needs_proxy": true
  },
  "params": {
    "rps": 40,
    "concurrency": 64,
    "ms": 300,
    "jitter_ms": 50,
    "duration_s": 60
  },
  "timeline": [
    {
      "at_s": 0,
      "do": "load.set",
      "args": {
        "rps": "{rps}",
        "concurrency": "{concurrency}"
      }
    },
    {
      "at_s": 10,
      "do": "phase",
      "phase": "steady"
    },
    {
      "at_s": 20,
      "do": "phase",
      "phase": "fault"
    },
    {
      "at_s": 20,
      "do": "fault.set",
      "edge": "proxied",
      "args": {
        "kind": "latency",
        "ms": "{ms}",
        "jitter_ms": "{jitter_ms}",
        "duration_s": 20
      }
    },
    {
      "at_s": 40,
      "do": "phase",
      "phase": "recovery"
    },
    {
      "at_s": "{duration_s}",
      "do": "load.stop"
    },
    {
      "at_s": "{duration_s}",
      "do": "end"
    }
  ],
  "collect": [
    "sagas_per_sec",
    "latency_p50_ms",
    "latency_p99_ms",
    "error_rate",
    "consumer_lag",
    "cpu_pct",
    "sagas_ok_total",
    "sagas_failed_total",
    "nodes_healthy",
    "link.error_rate[*]",
    "container.cpu[*]",
    "container.mem_mb[*]"
  ],
  "assert": [
    {
      "metric": "error_rate.mean",
      "op": "<=",
      "value": 0.01,
      "phase": "steady"
    },
    {
      "metric": "recovery_time_s",
      "op": "<=",
      "value": 15
    }
  ]
}
