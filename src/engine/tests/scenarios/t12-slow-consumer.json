{
  "id": "t12-slow-consumer",
  "name": "Slow consumer",
  "description": "Make one consumer/participant hold each request for io_ms.",
  "reveals": "Backpressure by queueing (lag grows) versus backpressure by blocking (latency grows).",
  "tags": [
    "capacity"
  ],
  "requires": {
    "kinds": [
      "infra",
      "service"
    ]
  },
  "params": {
    "rps": 40,
    "concurrency": 64,
    "io_ms": 200,
    "duration_s": 60
  },
  "timeline": [
    {
      "at_s": 0,
      "do": "load.set",
      "args": {
        "rps": "{rps}",
        "concurrency": "{concurrency}"
      }
    },
    {
      "at_s": 10,
      "do": "phase",
      "phase": "steady"
    },
    {
      "at_s": 20,
      "do": "phase",
      "phase": "pressure"
    },
    {
      "at_s": 20,
      "do": "control",
      "kind": "consumer",
      "args": {
        "op": "work.set",
        "params": {
          "io_ms": "{io_ms}"
        }
      }
    },
    {
      "at_s": 40,
      "do": "phase",
      "phase": "recovery"
    },
    {
      "at_s": 40,
      "do": "control",
      "kind": "consumer",
      "args": {
        "op": "work.set",
        "params": {
          "io_ms": 0
        }
      }
    },
    {
      "at_s": "{duration_s}",
      "do": "load.stop"
    },
    {
      "at_s": "{duration_s}",
      "do": "end"
    }
  ],
  "collect": [
    "sagas_per_sec",
    "latency_p50_ms",
    "latency_p99_ms",
    "error_rate",
    "consumer_lag",
    "cpu_pct",
    "sagas_ok_total",
    "sagas_failed_total",
    "nodes_healthy",
    "link.error_rate[*]",
    "container.cpu[*]",
    "container.mem_mb[*]"
  ],
  "assert": [
    {
      "metric": "error_rate.mean",
      "op": "<=",
      "value": 0.01,
      "phase": "steady"
    }
  ]
}
